    "Sarı fosforlu kalem; metnin altında kalır gibi yarı saydam çizer.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein gelber Textmarker, der halbtransparent zeichnet, als läge er unter dem Text."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A yellow highlighter that draws semi-transparently, as if beneath the text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un resaltador amarillo semitransparente que pinta como si estuviera debajo del texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un surligneur jaune semi-transparent, comme s’il passait sous le texte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un evidenziatore giallo semitrasparente, come se passasse sotto il testo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um marca-texto amarelo semitransparente, como se passasse por baixo do texto."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarı fosforlu kalem; metnin altında kalır gibi yarı saydam çizer."
          }
        }
      }
    },
