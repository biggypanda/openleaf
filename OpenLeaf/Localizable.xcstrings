    "Ders notlarını tutman için yapıldı. Tamamen ücretsiz; reklam çıkmaz, üyelik istemez.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemacht für deine Mitschriften. Komplett kostenlos: keine Werbung, keine Anmeldung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Made for taking notes in class. It's completely free: no ads, no sign-up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hecha para tomar apuntes en clase. Totalmente gratis: sin anuncios y sin registro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conçue pour prendre des notes en cours. Entièrement gratuite : pas de pub, pas d’inscription."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pensata per prendere appunti a lezione. Completamente gratis: niente pubblicità, niente registrazione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Feito para fazer anotações na aula. Totalmente grátis: sem anúncios e sem cadastro."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ders notlarını tutman için yapıldı. Tamamen ücretsiz; reklam çıkmaz, üyelik istemez."
          }
        }
      }
    },
