    "Notların yalnızca senin iCloud hesabına gider. Biz göremeyiz; OpenLeaf hiçbir veri toplamaz.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Notizen gehen nur in deinen eigenen iCloud-Account. Wir können sie nicht sehen; OpenLeaf erfasst keine Daten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your notes go only to your own iCloud account. We cannot see them; OpenLeaf collects no data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus notas solo van a tu propia cuenta de iCloud. Nosotros no podemos verlas; OpenLeaf no recoge ningún dato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos notes vont uniquement sur votre propre compte iCloud. Nous ne pouvons pas les voir ; OpenLeaf ne collecte aucune donnée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi appunti vanno solo sul tuo account iCloud. Noi non possiamo vederli; OpenLeaf non raccoglie alcun dato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas anotações vão só para a sua própria conta do iCloud. Nós não conseguimos vê-las; o OpenLeaf não coleta nenhum dado."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notların yalnızca senin iCloud hesabına gider. Biz göremeyiz; OpenLeaf hiçbir veri toplamaz."
          }
        }
      }
    },
    "Notların yalnızca seçtiğin klasöre yazılır. Biz göremeyiz; OpenLeaf hiçbir veri toplamaz. Klasörü Dosyalar penceresinden seçersin; Google Drive, Dropbox ya da OneDrive uygulaması kuruluysa orada görünür.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Notizen werden nur in den Ordner geschrieben, den du auswählst. Wir können sie nicht sehen; OpenLeaf erfasst keine Daten. Den Ordner wählst du im Dateien-Fenster; Google Drive, Dropbox oder OneDrive erscheinen dort, wenn die jeweilige App installiert ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your notes are written only to the folder you choose. We cannot see them; OpenLeaf collects no data. You pick the folder in the Files window; Google Drive, Dropbox or OneDrive appear there if their app is installed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus notas solo se guardan en la carpeta que elijas. Nosotros no podemos verlas; OpenLeaf no recoge ningún dato. Eliges la carpeta en la ventana de Archivos; si tienes instalada la app de Google Drive, Dropbox u OneDrive, aparecerá ahí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos notes sont enregistrées uniquement dans le dossier de votre choix. Nous ne pouvons pas les voir ; OpenLeaf ne collecte aucune donnée. Vous choisissez le dossier dans la fenêtre Fichiers ; Google Drive, Dropbox ou OneDrive y apparaissent si leur app est installée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi appunti vengono scritti solo nella cartella che scegli. Noi non possiamo vederli; OpenLeaf non raccoglie alcun dato. Scegli la cartella nella finestra File; Google Drive, Dropbox o OneDrive compaiono lì se hai installato la loro app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas anotações são gravadas só na pasta que você escolher. Nós não conseguimos vê-las; o OpenLeaf não coleta nenhum dado. Você escolhe a pasta na janela do Arquivos; Google Drive, Dropbox ou OneDrive aparecem ali se o app deles estiver instalado."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notların yalnızca seçtiğin klasöre yazılır. Biz göremeyiz; OpenLeaf hiçbir veri toplamaz. Klasörü Dosyalar penceresinden seçersin; Google Drive, Dropbox ya da OneDrive uygulaması kuruluysa orada görünür."
          }
        }
      }
    },
