    "Bu dosya açılamadı. Bozuk ya da parola korumalı bir PDF olabilir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei konnte nicht geöffnet werden. Möglicherweise ist das PDF beschädigt oder passwortgeschützt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file couldn’t be opened. It may be a damaged or password-protected PDF."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir este archivo. Puede que el PDF esté dañado o protegido con contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir ce fichier. Le PDF est peut-être endommagé ou protégé par un mot de passe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire questo file. Il PDF potrebbe essere danneggiato o protetto da password."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir este arquivo. O PDF pode estar danificado ou protegido por senha."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosya açılamadı. Bozuk ya da parola korumalı bir PDF olabilir."
          }
        }
      }
    },
