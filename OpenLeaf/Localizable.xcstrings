    "Silinen belgeler burada kalır; geri yükleyebilir ya da kalıcı olarak silebilirsin.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelöschte Dokumente bleiben hier, bis du sie wiederherstellst oder endgültig löschst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleted documents stay here until you restore them or delete them permanently."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los documentos eliminados se quedan aquí hasta que los restaures o los elimines para siempre."
          }
        },
        "fr": {
