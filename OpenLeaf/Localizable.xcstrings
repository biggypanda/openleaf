    "Geri yükleme yalnızca bu iPad'de olmayan defterleri ekler. Var olan defterlerine dokunmaz, hiçbir şeyi silmez.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Wiederherstellen werden nur Notizbücher hinzugefügt, die nicht auf diesem iPad sind. Vorhandene Notizbücher bleiben unberührt, nichts wird gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restoring only adds notebooks that are not on this iPad. It does not touch your existing notebooks and deletes nothing."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri yükleme yalnızca bu iPad'de olmayan defterleri ekler. Var olan defterlerine dokunmaz, hiçbir şeyi silmez."
          }
        }
      }
    },
