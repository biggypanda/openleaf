    "Bir belgeye basılı tutup Favorilere ekleyin.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte ein Dokument gedrückt und wähle „Zu Favoriten hinzufügen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch and hold a document, then choose Add to Favorites."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado un documento y elige Añadir a favoritos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez longuement un document, puis choisissez Ajouter aux favoris."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto un documento, poi scegli Aggiungi ai preferiti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e segure um documento e escolha Adicionar aos favoritos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir belgeye basılı tutup Favorilere ekleyin."
          }
        }
      }
    },
    "Bir belgeye basılı tutup “Klasöre taşı”yı seçin ya da Yeni ile burada oluşturun.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte ein Dokument gedrückt und wähle „In Ordner bewegen“ oder erstelle hier eins mit „Neu“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch and hold a document and choose “Move to Folder”, or create one here with New."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado un documento y elige “Mover a carpeta”, o crea una aquí con Nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez longuement un document et choisissez « Déplacer vers un dossier », ou créez-en un ici avec Nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto un documento e scegli “Sposta in cartella”, oppure creane una qui con Nuovo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e segure um documento e escolha “Mover para pasta”, ou crie uma aqui com Novo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir belgeye basılı tutup “Klasöre taşı”yı seçin ya da Yeni ile burada oluşturun."
          }
        }
      }
    },
