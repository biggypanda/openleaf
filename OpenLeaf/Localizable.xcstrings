    "Ezberlemen gereken yerin üstünü bantla kapat. Aklına gelmezse banta dokun, cevap altından çıksın.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleb ab, was du auswendig lernen musst. Fällt es dir nicht ein? Tipp auf das Band und die Antwort kommt darunter zum Vorschein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put tape over what you need to memorize. Can't recall it? Tap the tape and the answer shows up underneath."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon cinta encima de lo que tienes que memorizar. ¿No te acuerdas? Toca la cinta y la respuesta aparece debajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez du ruban sur ce que vous devez apprendre par cœur. Ça ne vous revient pas ? Touchez le ruban et la réponse apparaît dessous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti il nastro su quello che devi imparare a memoria. Non ti viene in mente? Tocca il nastro e sotto compare la risposta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque fita sobre o que você precisa decorar. Não lembrou? Toque na fita e a resposta aparece embaixo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezberlemen gereken yerin üstünü bantla kapat. Aklına gelmezse banta dokun, cevap altından çıksın."
          }
        }
      }
    },
