    "Tüm defterlerin tek dosyada. Uygulamayı silsen bile bu dosyadan geri yükleyebilirsin.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle deine Notizbücher in einer einzigen Datei. Auch wenn du die App löschst, kannst du sie aus dieser Datei wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All your notebooks are in a single file. Even if you delete the app, you can restore from this file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos tus cuadernos en un solo archivo. Aunque borres la app, puedes restaurarlos desde este archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous vos carnets dans un seul fichier. Même si vous supprimez l’app, vous pouvez les restaurer à partir de ce fichier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i tuoi quaderni in un unico file. Anche se elimini l’app, puoi ripristinarli da questo file."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os seus cadernos num único arquivo. Mesmo se você apagar o app, dá para restaurar a partir deste arquivo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm defterlerin tek dosyada. Uygulamayı silsen bile bu dosyadan geri yükleyebilirsin."
          }
        }
      }
    },
