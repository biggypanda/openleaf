    "%lld defter indirilemedi; internet bağlantını kontrol edip yeniden dene.": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Notizbuch konnte nicht geladen werden; prüfe deine Internetverbindung und versuche es erneut."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Notizbücher konnten nicht geladen werden; prüfe deine Internetverbindung und versuche es erneut."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld notebook could not be downloaded; check your internet connection and try again."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld notebooks could not be downloaded; check your internet connection and try again."
                }
              }
            }
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld defter indirilemedi; internet bağlantını kontrol edip yeniden dene."
          }
        }
