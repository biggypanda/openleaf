    "Geri yükleme yalnızca bu iPad'de olmayan defterleri ekler. Var olan defterlerine dokunmaz, hiçbir şeyi silmez.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Wiederherstellen werden nur Notizbücher hinzugefügt, die nicht auf diesem iPad sind. Vorhandene Notizbücher bleiben unberührt, nichts wird gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restoring only adds notebooks that are not on this iPad. It does not touch your existing notebooks and deletes nothing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar solo añade los cuadernos que no están en este iPad. No toca los que ya tienes y no borra nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La restauration ajoute uniquement les carnets absents de cet iPad. Elle ne touche pas à vos carnets existants et ne supprime rien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ripristino aggiunge solo i quaderni che non sono su questo iPad. Non tocca quelli che hai già e non elimina niente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A restauração só adiciona os cadernos que não estão neste iPad. Ela não mexe nos cadernos que você já tem e não apaga nada."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri yükleme yalnızca bu iPad'de olmayan defterleri ekler. Var olan defterlerine dokunmaz, hiçbir şeyi silmez."
          }
        }
      }
    },
