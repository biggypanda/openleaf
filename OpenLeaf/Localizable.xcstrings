    "Bu yedek kalıcı olarak silinir. Bu iPad'deki defterlerine bir şey olmaz.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Backup wird endgültig gelöscht. Die Notizbücher auf diesem iPad bleiben unberührt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This backup is deleted permanently. The notebooks on this iPad are not affected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia se eliminará para siempre. Los cuadernos de este iPad no se verán afectados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette sauvegarde sera supprimée définitivement. Les carnets de cet iPad ne sont pas touchés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo backup verrà eliminato definitivamente. I quaderni su questo iPad non verranno toccati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este backup será apagado para sempre. Os cadernos deste iPad não serão afetados."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yedek kalıcı olarak silinir. Bu iPad'deki defterlerine bir şey olmaz."
          }
