    "Ezberlemen gereken yerin üstünü bantla kapat. Aklına gelmezse banta dokun, cevap altından çıksın.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleb ab, was du auswendig lernen musst. Fällt es dir nicht ein? Tipp auf das Band und die Antwort kommt darunter zum Vorschein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put tape over what you need to memorize. Can't recall it? Tap the tape and the answer shows up underneath."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezberlemen gereken yerin üstünü bantla kapat. Aklına gelmezse banta dokun, cevap altından çıksın."
          }
        }
      }
    },
