    "Bir belgeye basılı tutup Favorilere ekleyin.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte ein Dokument gedrückt und wähle „Zu Favoriten hinzufügen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch and hold a document, then choose Add to Favorites."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir belgeye basılı tutup Favorilere ekleyin."
          }
        }
      }
    },
    "Bir belgeye basılı tutup “Klasöre taşı”yı seçin ya da Yeni ile burada oluşturun.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte ein Dokument gedrückt und wähle „In Ordner bewegen“ oder erstelle hier eins mit „Neu“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch and hold a document and choose “Move to Folder”, or create one here with New."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir belgeye basılı tutup “Klasöre taşı”yı seçin ya da Yeni ile burada oluşturun."
          }
        }
      }
    },
