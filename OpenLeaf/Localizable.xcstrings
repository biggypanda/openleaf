    "Bu dosya açılamadı. Bozuk ya da parola korumalı bir PDF olabilir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei konnte nicht geöffnet werden. Möglicherweise ist das PDF beschädigt oder passwortgeschützt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file couldn’t be opened. It may be a damaged or password-protected PDF."
