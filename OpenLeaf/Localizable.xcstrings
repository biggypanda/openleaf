    "Bu klasöre kalıcı erişim alınamadı. Başka bir klasör seçmeyi dene.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Ordner konnte kein dauerhafter Zugriff eingerichtet werden. Wähle einen anderen Ordner."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lasting access to this folder could not be obtained. Try choosing another folder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo obtener acceso permanente a esta carpeta. Prueba a elegir otra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’obtenir un accès durable à ce dossier. Essayez d’en choisir un autre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile ottenere un accesso permanente a questa cartella. Prova a sceglierne un’altra."
          }
        },
        "pt-BR": {
