    "%lld defter indirilemedi; internet bağlantını kontrol edip yeniden dene.": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Notizbuch konnte nicht geladen werden; prüfe deine Internetverbindung und versuche es erneut."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Notizbücher konnten nicht geladen werden; prüfe deine Internetverbindung und versuche es erneut."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld notebook could not be downloaded; check your internet connection and try again."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld notebooks could not be downloaded; check your internet connection and try again."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "No se pudo descargar %lld cuaderno; revisa tu conexión a internet e inténtalo de nuevo."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "No se pudieron descargar %lld cuadernos; revisa tu conexión a internet e inténtalo de nuevo."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld carnet n’a pas pu être téléchargé ; vérifiez votre connexion internet et réessayez."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld carnets n’ont pas pu être téléchargés ; vérifiez votre connexion internet et réessayez."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Impossibile scaricare %lld quaderno; controlla la connessione a internet e riprova."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Impossibile scaricare %lld quaderni; controlla la connessione a internet e riprova."
                }
              }
            }
          }
        },
        "pt-BR": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Não foi possível baixar %lld caderno; verifique sua conexão com a internet e tente de novo."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Não foi possível baixar %lld cadernos; verifique sua conexão com a internet e tente de novo."
                }
              }
            }
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld defter indirilemedi; internet bağlantını kontrol edip yeniden dene."
          }
        }
      }
    },
