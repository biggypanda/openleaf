    "Tüm defterlerin tek dosyada. Uygulamayı silsen bile bu dosyadan geri yükleyebilirsin.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle deine Notizbücher in einer einzigen Datei. Auch wenn du die App löschst, kannst du sie aus dieser Datei wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All your notebooks are in a single file. Even if you delete the app, you can restore from this file."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm defterlerin tek dosyada. Uygulamayı silsen bile bu dosyadan geri yükleyebilirsin."
          }
        }
      }
