    "Aç": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einschalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn On"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aç"
          }
        }
      }
    },
    "Açarsan defterlerin kendi iCloud hesabına kendiliğinden yedeklenir; iPad'in bozulsa bile notların kaybolmaz. Notların yalnızca senin iCloud'unda durur, biz göremeyiz. İstediğin zaman kapatabilir ya da başka bir yedek yeri seçebilirsin.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du das einschaltest, werden deine Notizbücher automatisch in deinem eigenen iCloud-Account gesichert; deine Notizen bleiben erhalten, selbst wenn dein iPad kaputtgeht. Sie liegen nur in deiner iCloud, wir können sie nicht sehen. Du kannst es jederzeit ausschalten oder einen anderen Backup-Ort wählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you turn this on, your notebooks are backed up to your own iCloud account automatically, so your notes survive even if your iPad breaks. Your notes stay only in your iCloud; we cannot see them. You can turn it off or choose another backup location at any time."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açarsan defterlerin kendi iCloud hesabına kendiliğinden yedeklenir; iPad'in bozulsa bile notların kaybolmaz. Notların yalnızca senin iCloud'unda durur, biz göremeyiz. İstediğin zaman kapatabilir ya da başka bir yedek yeri seçebilirsin."
          }
        }
      }
    },
